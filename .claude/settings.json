{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "permissions": {
    "allow": [
      "Bash(npm run verify:*)",
      "Bash(npm run check)",
      "Bash(npm run lint)",
      "Bash(npm run typecheck)",
      "Bash(npm run test:*)",
      "Bash(npm run api:*)",
      "Bash(npm run audit)",
      "Bash(npm run build)",
      "Bash(npm run format:*)",
      "Bash(npm run db:up)",
      "Bash(npm run db:update)",
      "Bash(npm run db:seed)",
      "Bash(docker compose ps:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git branch:*)",
      "Bash(git fetch:*)",
      "Bash(gh api user:*)",
      "Bash(gh issue view:*)",
      "Bash(gh issue list:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr diff:*)",
      "Bash(gh pr checks:*)",
      "Bash(gh run view:*)",
      "Bash(gh run list:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.*.local)",
      "Bash(cat .env:*)",
      "Bash(head .env:*)",
      "Bash(tail .env:*)",
      "Bash(less .env:*)",
      "Bash(more .env:*)",
      "Bash(type .env:*)",
      "Bash(Get-Content .env:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git push --no-verify:*)",
      "Bash(git commit --no-verify:*)",
      "Bash(git commit -n:*)",
      "Bash(npx prisma migrate reset:*)",
      "Bash(npx prisma db push --force-reset:*)",
      "Bash(docker compose down -v:*)",
      "Bash(docker volume rm:*)"
    ]
  }
}
