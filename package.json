{
  "name": "teachback",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=24",
      "onFail": "error"
    },
    "packageManager": {
      "name": "npm",
      "version": ">=11.11.0 <12",
      "onFail": "error"
    }
  },
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "dev": "next dev -H 127.0.0.1",
    "build": "next build",
    "start": "next start -H 127.0.0.1",
    "verify": "node scripts/verify.mjs",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "node scripts/check-test-inventory.mjs && vitest run --project unit --project unit-dom",
    "test:ci": "node scripts/check-test-inventory.mjs && vitest run --project unit --project unit-dom --project integration --coverage",
    "audit": "npm audit --omit=dev --audit-level=high",
    "db:up": "docker compose up -d --wait db db-test",
    "db:down": "docker compose down",
    "db:migrate": "prisma migrate dev",
    "db:update": "prisma migrate deploy && prisma generate",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "db:generate": "prisma generate",
    "prepare": "node scripts/install-hooks.mjs",
    "postinstall": "prisma generate",
    "ai:ping": "tsx --env-file-if-exists=.env scripts/ai-ping.ts",
    "api:lint": "node scripts/api-lint.mjs",
    "api:types": "node scripts/api-types.mjs",
    "api:types:check": "node scripts/api-types.mjs --check",
    "test:int": "node scripts/check-test-inventory.mjs && vitest run --project integration"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@dagrejs/dagre": "3.1.1",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@scalar/nextjs-api-reference": "^0.12.12",
    "@xyflow/react": "12.12.0",
    "better-auth": "1.7.13",
    "next": "16.4.3",
    "openapi-fetch": "^0.17.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@redocly/cli": "^2.71.0",
    "@tailwindcss/turbopack": "^4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^5.0.5",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "js-yaml": "^5.5.0",
    "jsdom": "^29.1.1",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.9.10",
    "prisma": "7.10.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.5"
  }
}
