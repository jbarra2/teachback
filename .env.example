# Copied to .env by `npm run setup`. Never commit .env.

# Local Docker Postgres (docker-compose.yml). DATABASE_URL = app runtime, DIRECT_URL = migrations.
DATABASE_URL=postgresql://teachback:teachback@127.0.0.1:5433/teachback
DIRECT_URL=postgresql://teachback:teachback@127.0.0.1:5433/teachback

# Auth. `npm run setup` generates the secret.
BETTER_AUTH_SECRET=replace-me
BETTER_AUTH_URL=http://localhost:3000

# AI: "fake" (free, deterministic) or "anthropic" (real Claude API calls, needs a key)
AI_PROVIDER=fake
ANTHROPIC_API_KEY=
AI_MODEL_FAST=claude-sonnet-5-5
AI_MODEL_SMART=claude-opus-5-5
# Fake provider only: force a failure (timeout, malformed, rate_limited, server_error, fabricated_evidence). Empty = none.
AI_FAKE_FAILURE=

# Limits
MAX_UPLOAD_MB=4
MAX_NOTE_CHARS=200000
RATE_LIMIT_AI_PER_MIN=20
RATE_LIMIT_AI_PER_DAY=300
RATE_LIMIT_UPLOADS_PER_HOUR=10
RATE_LIMIT_AI_GLOBAL_PER_DAY=2000

# API docs (Scalar) at /api/docs
API_DOCS_ENABLED=true

# Frontend mocks: comma list (courses,documents,concepts,question,answer,map,next). Empty = real API.
NEXT_PUBLIC_MOCK_ENDPOINTS=
